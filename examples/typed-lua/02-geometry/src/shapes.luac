#include <math.luah>
#include "shapes.luah"

local function area(s: Shape): number
  if s.kind == "circle" then
    return math.pi * s.r ^ 2 -- s is a Circle here
  end
  return s.w * s.h -- and a Rect here
end

local function total_area(shapes: Shape[]): number
  local total: number = 0
  for _, s in ipairs(shapes) do
    total = total + area(s)
  end
  return total
end

local function largest<T>(items: T[], measure: (item: T) -> number): T?
  local best: T? = nil
  local best_size: number = -math.huge
  for _, item in ipairs(items) do
    local size = measure(item)
    if size > best_size then
      best, best_size = item, size
    end
  end
  return best
end

return { area = area, total_area = total_area, largest = largest }
