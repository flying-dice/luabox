-- love.luah: the slice of the LÖVE API this game uses. LÖVE provides `love`
-- as a global, so it is declared `extern`. The callbacks are fields the game
-- fills in; LÖVE calls whichever ones are set.

typedef LoveGraphics = {
  rectangle: (mode: string, x: number, y: number, w: number, h: number) -> void,
  print: (text: string, x: number, y: number) -> void,
}

typedef LoveKeyboard = { isDown: (key: string) -> boolean }

typedef LoveEvent = { quit: () -> void }

typedef Love = {
  graphics: LoveGraphics,
  keyboard: LoveKeyboard,
  event: LoveEvent,
  load: () -> void,
  update: (dt: number) -> void,
  draw: () -> void,
}

extern love: Love
