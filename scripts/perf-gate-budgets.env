# Single source for the budget constants scripts/perf-gate.sh and
# scripts/perf-gate.ps1 both need to agree on byte-for-byte. Before this
# file, both scripts hand-carried their own copy of these numbers (bash at
# perf-gate.sh:77-108, PowerShell at perf-gate.ps1:95-124) with no shared
# source — perf-gate-lib.sh was created in the same round to end exactly
# this drift for the helper FUNCTIONS (scale_budget_ms,
# assert_lua_file_count, write_perf_manifest) and the constants were left
# duplicated (#58 review round 6, M50). This is a plain KEY=VALUE file: a
# bash `source` reads it directly as shell assignments, and
# scripts/perf-gate-lib.ps1's Read-PerfBudgets parses it the same way for
# PowerShell — one file, two readers, no reimplementation on either side.
#
# Blank lines and lines starting with `#` are comments; every other line is
# `KEY=INTEGER`, no quoting, no spaces around `=` (the bash reader sources
# this literally, so it must also be valid bash).

# Cold start (luabox --version) and warm fmt --check. SPEC.md §16.1: cold
# start < 50 ms. Real, LUABOX_PERF_FACTOR=1.0 measurements this session (5
# runs, LUABOX_BIN pinned to a freshly built release binary, ~100-kLOC
# corpus): cold start 7-9 ms (5.5-7x headroom), fmt --check 238-268 ms
# (7.5-8x headroom) — both comfortable, unchanged.
COLD_START_BUDGET_BASE_MS=50
FMT_BUDGET_BASE_MS=2000

# CHECK_BUDGET_BASE_MS — #58 review round 6, M37: this was 1000 ms,
# encoding SPEC.md §16.1's "check < 1 s warm" acceptance figure directly as
# the budget. That figure is stale against the checker's current cost on
# real hardware: measured HERE, this session, LUABOX_PERF_FACTOR=1.0, same
# method as above, `check` on the ~100-kLOC corpus took 2279/2353/2456/
# 2467/2981 ms across 5 runs (min 2279, max 2981, mean ~2507) — a plain
# `bash scripts/perf-gate.sh` FAILED on a correct, unmodified checkout,
# every single run, passing only because CI's LUABOX_PERF_FACTOR=4.0
# (ci.yml) inflates the 1000 ms budget enough to clear it. Rebased here
# (decision: (a) from that finding's two options — fix the STATED budget
# against real numbers, not the DEFAULT FACTOR against the machine; see
# that finding's full reasoning in perf-gate.sh's own header comment) to
# 7500 ms: ~2.5x the worst run measured this session and ~3x the mean,
# matching this file's existing ~3x headroom convention for the
# diagnostics-heavy legs below. SPEC.md §16.1's "<1s" figure is now
# aspirational relative to what this gate enforces, not a fact this budget
# restates — catching a regression from today's real baseline is this
# gate's job; re-hitting a historical target is not something changing this
# constant can do on its own. NOT touched: perf-gate.ps1 (no `pwsh` on this
# box to remeasure the Windows path — see perf-gate.ps1's own note) but it
# reads this same file, so the new budget applies there too, unverified.
CHECK_BUDGET_BASE_MS=7500
# CHECK_CEILING_MS — local merge-gate finding on the rebase above. Raising
# the base from 1000 to 7500 fixed a gate that failed on correct code, but
# LUABOX_PERF_FACTOR multiplies the whole budget, so CI (factor 4.0) went
# from a 4000 ms ceiling to a 30000 ms one — about 12x the ~2.5 s baseline
# measured this session, which is not a gate at all. Capping the SCALED
# budget keeps CI's ceiling at ~3.2x that baseline while leaving the base
# generous enough that a loaded dev box does not go red on correct code.
# The two knobs now do separate jobs: the base absorbs local noise, the
# ceiling bounds how blind CI is allowed to get.
CHECK_CEILING_MS=8000

# Diagnostics-heavy legs, on one file holding DIAG_CORPUS_FINDINGS findings.
# Calibrated on the dev baseline (see CHANGELOG "Fixed", wave 8):
#   lint (suppressed)   357 ms fixed / 14 163 ms with the quadratic lookup restored
#   check (suppressed)  663 ms fixed /  4 183 ms ditto
#   lint (rendered)      162 ms fixed /  9 295 ms with the quadratic renderer restored
#   check (rendered)     788 ms fixed / 15 462 ms ditto
# The suppressed budgets sit ~3x above the fixed numbers (headroom for a
# noisy box, on top of LUABOX_PERF_FACTOR / -Factor) and ~3-12x below the
# broken ones; the rendered budgets are ~3x above fixed and >=6x below
# broken. Rendered `lint` is *faster* than the suppressed leg because
# resolving DIAG_CORPUS_FINDINGS `---@luabox-ignore` directives costs more
# than printing that many frames — the suppressed leg is not a subset of
# the rendered one, which is why both pairs stay.
DIAG_LINT_BUDGET_BASE_MS=1200

# DIAG_CHECK_BUDGET_BASE_MS — #58 review round 6, M37 follow-up: this
# leg's real cost on this box was flush against its old 1500 ms budget
# rather than outright broken (found while measuring CHECK_BUDGET_BASE_MS
# above, same 5 runs): 1385/1306/1291/1331/1313 ms four times and one
# 1863 ms spike — i.e. it FAILED once in five otherwise-passing runs at
# LUABOX_PERF_FACTOR=1.0, a flaky gate on correct code. Rebased to 4000 ms:
# ~2.1x the worst run measured this session (the 1863 ms spike) and ~3x the
# typical ~1330 ms, matching the other diagnostics-heavy legs' headroom.
DIAG_CHECK_BUDGET_BASE_MS=4000
# Same reasoning as CHECK_CEILING_MS: ~1330 ms typical, 1863 ms worst this
# session; factor 4.0 would otherwise put CI's ceiling at 16000 ms (~12x).
DIAG_CHECK_CEILING_MS=4500
DIAG_LINT_RENDERED_BUDGET_BASE_MS=600
DIAG_CHECK_RENDERED_BUDGET_BASE_MS=2400
DIAG_CORPUS_FINDINGS=20000

# Peak-RSS ceiling for `check` on the 100-kLOC corpus, in MiB. decisions/07
# accepted 64 -> 123 MiB; measured 123 MiB (three runs, identical, Linux dev
# baseline) so the budget sits at ~2.4x that. Wide on purpose: this is a
# ceiling that catches a *regime* change (a whole-project structure
# retained, a per-file clone that used to be a borrow), not a 10% drift —
# allocator behaviour, page-cache pressure and (on Windows) working-set
# accounting vary too much between machines and OSes for a tight memory
# gate to mean anything. NOT scaled by LUABOX_PERF_FACTOR / -Factor: a slow
# or loaded machine runs the same allocations, it just takes longer over
# them, so a CPU multiplier has no business loosening a memory ceiling.
# $LUABOX_RSS_BUDGET_MIB / $env:LUABOX_RSS_BUDGET_MIB overrides it, for when
# the budget itself is being renegotiated.
RSS_BUDGET_MIB=300
