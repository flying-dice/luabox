/target
tools/gen-corpus/target/
tools/differ/target/

# Example build artifacts, and the rock tree a user materializes with luarocks.
examples/**/dist/
examples/**/lua_modules/
# `luabox doc` output. Generated on demand by the examples gate; checking it in
# only ever produced a stale copy of a site the binary regenerates in a second.
examples/**/doc/

# IDE state
.idea/

# GitLab CI scratch. GitLab can only cache and upload paths under the project
# directory, so .gitlab-ci.yml puts CARGO_HOME, the pinned pwsh/luals trees,
# the mutants report and the coverage lcovs here rather than in $HOME or a
# temp dir. They must be IGNORED, not merely untracked: cargo-mutants copies
# the source tree for every mutant and skips git-ignored paths, so an
# unignored cache directory would be duplicated into each build.
/.cargo/
/.ci-tmp/
/.luals/
/.pwsh/
/mutants-out/
/lcov-unit.info
/lcov-e2e.info
