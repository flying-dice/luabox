#include <math.luah>
#include "shapes.luah"

local function number area(Shape s)
  if s.kind == "circle" then
    return math.pi * s.r ^ 2 -- s is a Circle here
  end
  return s.w * s.h -- and a Rect here
end

local function number total_area(Shape[] shapes)
  local number total = 0
  for _, s in ipairs(shapes) do
    total = total + area(s)
  end
  return total
end

local function T? largest<T>(T[] items, number(T item) measure)
  local T? best = nil
  local number best_size = -math.huge
  for _, item in ipairs(items) do
    local size = measure(item)
    if size > best_size then
      best, best_size = item, size
    end
  end
  return best
end

return { area = area, total_area = total_area, largest = largest }
