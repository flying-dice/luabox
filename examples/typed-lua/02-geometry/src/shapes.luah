-- shapes: plain data and a tagged union. No methods and no metatables: the
-- `kind` field tells the shapes apart.
#include "vec.luah"

typedef Circle = { kind: "circle", centre: Vec, r: number }
typedef Rect = { kind: "rect", origin: Vec, w: number, h: number }
typedef Shape = Circle | Rect

area(s: Shape): number
total_area(shapes: Shape[]): number
largest<T>(items: T[], measure: (item: T) -> number): T?
