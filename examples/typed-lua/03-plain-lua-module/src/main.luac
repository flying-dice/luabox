#include <string.luah>
#include "csv.luah"

local csv = require("csv")

typedef { string name, number price } Item

local function Item? to_item(Row row)
  local number? price = tonumber(row[2])
  if price == nil then
    return nil
  end
  return { name = row[1], price = price }
end

local Row[] rows = csv.parse("apple,0.5\npear,0.75\nbad,row\nplum,1.25")
local number total = 0
for integer line, Row row in ipairs(rows) do
  local item = to_item(row)
  if item then
    total = total + item.price
    print(string.format("%-6s %5.2f", item.name, item.price))
  else
    print("skipped line " .. line)
  end
end
print(string.format("%-6s %5.2f", "total", total))
