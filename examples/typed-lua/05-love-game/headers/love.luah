-- love.luah: the slice of the LÖVE API this game uses. LÖVE provides `love`
-- as a global, so it is declared `extern`. The callbacks are optional fields
-- the game fills in; LÖVE calls whichever ones are set.

typedef "fill" | "line" DrawMode
typedef "left" | "right" | "up" | "down" | "escape" Key

typedef {
  void(DrawMode mode, number x, number y, number w, number h) rectangle,
  void(string text, number x, number y) print,
} LoveGraphics

typedef { boolean(Key key) isDown } LoveKeyboard

typedef { void() quit } LoveEvent

typedef {
  LoveGraphics graphics,
  LoveKeyboard keyboard,
  LoveEvent event,
  (void())? load,
  (void(number dt))? update,
  (void())? draw,
} Love

extern Love love
